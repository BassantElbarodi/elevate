# Copy this file to .env.local and fill in the two values from Supabase:
#   Project Settings -> API
#
# Both of these are safe in a browser. The anon key is designed to be public;
# Row Level Security is what protects the data, not secrecy of this key.
#
# Do NOT put the service_role key here. It bypasses RLS entirely and would give
# anyone who found it full read/write access to every student's data.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
